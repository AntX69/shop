{
  "name": "storepos",
  "productName": "StorePOS",
  "description": "StorePOS — ლოკალური მაღაზიის მართვა (Offline Windows Desktop)",
  "author": "StorePOS",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:electron": "node scripts/build-electron.mjs && electron .",
    "build:renderer": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "pack": "npm run build && electron-builder --dir",
    "preview": "vite preview",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:e2e": "node --test e2e/",
    "lint": "tsc --noEmit",
    "clean": "node scripts/clean.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
